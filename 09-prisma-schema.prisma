// ================================================================
// This file is the literal Prisma schema derived from 04-database.md.
// Copy directly into Backend/prisma/schema.prisma as the starting point
// for Milestone 1. Review §4 of 04-database.md alongside this for the
// reasoning behind each modeling choice (partial unique indexes,
// capacity reservation pattern, pricing tier resolution, etc.)
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------
// Enums
// ----------------------------------------------------------------

enum RoleName {
  ADMIN
  ORGANIZER
  VOUCHER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Locale {
  en
  fa
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum EventStatus {
  DRAFT
  OPEN
  FULL
  CLOSED
  CANCELLED
  COMPLETED
}

enum EventVisibilityMode {
  ALL_APPROVED
  SELECTED_USERS
  SELECTED_VOUCHERS
  INVITE_ONLY
}

enum EventAccessGrantType {
  USER
  VOUCHER_INVITEES
}

enum RegistrationStatus {
  PENDING_APPROVAL
  REJECTED
  APPROVED
  PENDING_PAYMENT
  CONFIRMED
  WAITLISTED
  CANCELLED
  EXPIRED
}

enum CapacityReservationStatus {
  ACTIVE
  RELEASED
}

enum CapacityOverrideStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WaitlistStatus {
  JOINED
  OFFERED
  CLAIMED
  EXPIRED
  LEFT
}

enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundStatus {
  NONE
  REQUESTED
  REFUNDED
}

enum TicketHolderType {
  PRIMARY
  GUEST
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  VOID
}

enum CheckInMethod {
  QR
  MANUAL
}

enum NotificationChannel {
  TELEGRAM
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AuditSource {
  TELEGRAM
  WEB
  ADMIN_API
  SYSTEM
}

// ----------------------------------------------------------------
// Users, roles, vouchers
// ----------------------------------------------------------------

model User {
  id                String     @id @default(uuid())
  telegramUserId    BigInt     @unique @map("telegram_user_id")
  telegramUsername  String?    @map("telegram_username")
  firstName         String     @map("first_name")
  lastName          String?    @map("last_name")
  locale            Locale     @default(en)
  status            UserStatus @default(PENDING)
  vouchedByUserId   String?    @map("vouched_by_user_id")
  vouchedByUser     User?      @relation("VouchedBy", fields: [vouchedByUserId], references: [id])
  vouchedUsers      User[]     @relation("VouchedBy")
  invitedAt         DateTime?  @map("invited_at")
  approvedAt        DateTime?  @map("approved_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  roles                UserRole[]
  invitationsSent      Invitation[]              @relation("VoucherInvitations")
  invitationsAccepted  Invitation[]              @relation("AcceptedInvitations")
  djsCreated           DJ[]
  locationsCreated     Location[]
  eventsOrganized      Event[]
  eventAccessGrants    EventAccessGrant[]
  registrations        EventRegistration[]
  waitlistEntries      WaitlistEntry[]
  checkInsPerformed    CheckIn[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  linkedGuestOf        RegistrationGuest[]

  @@map("users")
}

model UserRole {
  userId         String   @map("user_id")
  role           RoleName
  grantedByUserId String? @map("granted_by_user_id")
  grantedAt      DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model Invitation {
  id                       String            @id @default(uuid())
  voucherUserId            String            @map("voucher_user_id")
  voucher                  User              @relation("VoucherInvitations", fields: [voucherUserId], references: [id])
  invitedTelegramUserId    BigInt?           @map("invited_telegram_user_id")
  invitedTelegramUsername  String?           @map("invited_telegram_username")
  status                   InvitationStatus  @default(PENDING)
  token                    String            @unique
  createdAt                DateTime          @default(now()) @map("created_at")
  acceptedAt               DateTime?         @map("accepted_at")
  acceptedUserId           String?           @map("accepted_user_id")
  acceptedUser              User?            @relation("AcceptedInvitations", fields: [acceptedUserId], references: [id])

  @@index([voucherUserId])
  @@map("invitations")
}

// ----------------------------------------------------------------
// DJs, Locations
// ----------------------------------------------------------------

model DJ {
  id               String    @id @default(uuid())
  name             String
  photoKey         String?   @map("photo_key")
  instagram        String?
  telegramUsername String?   @map("telegram_username")
  genre            String?
  bio              String?
  createdByUserId  String    @map("created_by_user_id")
  createdBy        User      @relation(fields: [createdByUserId], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  eventDJs EventDJ[]

  @@map("djs")
}

model Location {
  id             String    @id @default(uuid())
  venueName      String    @map("venue_name")
  address        String
  googleMapsUrl  String?   @map("google_maps_url")
  latitude       Float?
  longitude      Float?
  metadata       Json?
  createdByUserId String   @map("created_by_user_id")
  createdBy      User      @relation(fields: [createdByUserId], references: [id])
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  events Event[]

  @@map("locations")
}

// ----------------------------------------------------------------
// Events
// ----------------------------------------------------------------

model Event {
  id                        String              @id @default(uuid())
  organizerId               String              @map("organizer_id")
  organizer                 User                @relation(fields: [organizerId], references: [id])
  name                       String
  description                String?
  coverImageKey              String?             @map("cover_image_key")
  category                   String?
  dressCode                  String?             @map("dress_code")
  ageRestriction              Boolean            @default(false) @map("age_restriction")
  minAge                      Int?               @map("min_age")
  rules                       String?
  locationId                  String?            @map("location_id")
  location                    Location?          @relation(fields: [locationId], references: [id])
  startAt                     DateTime           @map("start_at")
  endAt                        DateTime          @map("end_at")
  capacity                    Int
  price                        Decimal           @db.Decimal(10, 2)
  currency                     String            @db.Char(3)
  maxPeoplePerRegistration     Int               @map("max_people_per_registration")
  approvalRequired             Boolean           @default(false) @map("approval_required")
  status                       EventStatus        @default(DRAFT)
  visibilityMode                EventVisibilityMode @default(ALL_APPROVED) @map("visibility_mode")
  locationReleasedAt            DateTime?         @map("location_released_at")
  notifyOnEditDefault            Boolean          @default(true) @map("notify_on_edit_default")
  createdAt                      DateTime         @default(now()) @map("created_at")
  updatedAt                      DateTime         @updatedAt @map("updated_at")
  deletedAt                      DateTime?        @map("deleted_at")

  eventDJs           EventDJ[]
  pricingTiers        PricingTier[]
  accessGrants         EventAccessGrant[]
  registrations         EventRegistration[]
  waitlistEntries        WaitlistEntry[]
  capacityReservations    CapacityReservation[]
  checkIns                 CheckIn[]

  @@index([status, startAt])
  @@index([organizerId, status])
  @@map("events")
}

model EventDJ {
  eventId  String @map("event_id")
  djId     String @map("dj_id")
  setOrder Int?   @map("set_order")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dj    DJ    @relation(fields: [djId], references: [id])

  @@id([eventId, djId])
  @@map("event_djs")
}

model PricingTier {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String?
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @db.Char(3)
  startsAt  DateTime @map("starts_at")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([eventId, startsAt])
  @@map("pricing_tiers")
}

model EventAccessGrant {
  id             String               @id @default(uuid())
  eventId        String               @map("event_id")
  event          Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  grantType      EventAccessGrantType @map("grant_type")
  subjectUserId  String?              @map("subject_user_id")
  subjectUser    User?                @relation(fields: [subjectUserId], references: [id])
  grantedByUserId String              @map("granted_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@unique([eventId, grantType, subjectUserId])
  @@map("event_access_grants")
}

// ----------------------------------------------------------------
// Registrations, guests, capacity
// ----------------------------------------------------------------

model EventRegistration {
  id                          String             @id @default(uuid())
  eventId                     String             @map("event_id")
  event                       Event              @relation(fields: [eventId], references: [id])
  primaryUserId               String             @map("primary_user_id")
  primaryUser                 User               @relation(fields: [primaryUserId], references: [id])
  peopleCount                 Int                @map("people_count")
  status                      RegistrationStatus
  priceSnapshot                Decimal           @map("price_snapshot") @db.Decimal(10, 2)
  currency                     String            @db.Char(3)
  approvalDecidedByUserId       String?          @map("approval_decided_by_user_id")
  approvalDecidedAt              DateTime?       @map("approval_decided_at")
  expiresAt                       DateTime?      @map("expires_at")
  createdAt                        DateTime      @default(now()) @map("created_at")
  updatedAt                        DateTime      @updatedAt @map("updated_at")

  guests               RegistrationGuest[]
  capacityReservation   CapacityReservation?
  capacityOverrides      CapacityOverrideRequest[]
  payments                Payment[]
  tickets                  Ticket[]

  // Partial unique index enforcing "one active registration per user per event" —
  // Prisma cannot express a partial index natively; add via raw SQL migration:
  //
  // CREATE UNIQUE INDEX uq_active_registration_per_user_event
  // ON "event_registrations" (event_id, primary_user_id)
  // WHERE status IN ('PENDING_APPROVAL','PENDING_PAYMENT','APPROVED','CONFIRMED','WAITLISTED');

  @@index([eventId, status])
  @@index([primaryUserId, status])
  @@map("event_registrations")
}

model RegistrationGuest {
  id               String   @id @default(uuid())
  registrationId   String   @map("registration_id")
  registration     EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  firstName        String   @map("first_name")
  lastName         String?  @map("last_name")
  telegramUserId   BigInt?  @map("telegram_user_id")
  telegramUsername String?  @map("telegram_username")
  linkedUserId     String?  @map("linked_user_id")
  linkedUser       User?    @relation(fields: [linkedUserId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  ticket Ticket?

  @@map("registration_guests")
}

model CapacityReservation {
  id             String                     @id @default(uuid())
  eventId        String                     @map("event_id")
  event          Event                      @relation(fields: [eventId], references: [id])
  registrationId String                     @unique @map("registration_id")
  registration   EventRegistration          @relation(fields: [registrationId], references: [id])
  peopleCount    Int                        @map("people_count")
  status         CapacityReservationStatus  @default(ACTIVE)
  createdAt      DateTime                   @default(now()) @map("created_at")
  releasedAt     DateTime?                  @map("released_at")

  @@index([eventId, status])
  @@map("capacity_reservations")
}

model CapacityOverrideRequest {
  id                   String                   @id @default(uuid())
  registrationId       String                   @map("registration_id")
  registration         EventRegistration        @relation(fields: [registrationId], references: [id])
  requestedExtraPeople Int                       @map("requested_extra_people")
  status               CapacityOverrideStatus    @default(PENDING)
  decidedByUserId      String?                   @map("decided_by_user_id")
  decidedAt            DateTime?                 @map("decided_at")
  createdAt            DateTime                  @default(now()) @map("created_at")

  @@map("capacity_override_requests")
}

// ----------------------------------------------------------------
// Waitlist
// ----------------------------------------------------------------

model WaitlistEntry {
  id             String         @id @default(uuid())
  eventId        String         @map("event_id")
  event          Event          @relation(fields: [eventId], references: [id])
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id])
  peopleCount    Int            @map("people_count")
  position       Int
  status         WaitlistStatus @default(JOINED)
  offerExpiresAt DateTime?      @map("offer_expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([eventId, status, position])
  @@map("waitlist_entries")
}

// ----------------------------------------------------------------
// Payments
// ----------------------------------------------------------------

model Payment {
  id                     String        @id @default(uuid())
  registrationId         String        @map("registration_id")
  registration           EventRegistration @relation(fields: [registrationId], references: [id])
  amount                  Decimal      @db.Decimal(10, 2)
  currency                 String      @db.Char(3)
  provider                  String
  providerTransactionId      String?   @map("provider_transaction_id")
  status                      PaymentStatus @default(CREATED)
  attemptNumber                 Int     @default(1) @map("attempt_number")
  rawProviderPayload             Json?  @map("raw_provider_payload")
  createdAt                       DateTime @default(now()) @map("created_at")
  paidAt                            DateTime? @map("paid_at")
  failedAt                           DateTime? @map("failed_at")
  refundStatus                        RefundStatus @default(NONE) @map("refund_status")
  refundAmount                         Decimal? @map("refund_amount") @db.Decimal(10, 2)

  @@unique([registrationId, attemptNumber])
  @@unique([provider, providerTransactionId])
  @@map("payments")
}

// ----------------------------------------------------------------
// Tickets, check-in
// ----------------------------------------------------------------

model Ticket {
  id             String            @id @default(uuid())
  registrationId String            @map("registration_id")
  registration   EventRegistration @relation(fields: [registrationId], references: [id])
  holderType     TicketHolderType  @map("holder_type")
  guestId        String?           @unique @map("guest_id")
  guest          RegistrationGuest? @relation(fields: [guestId], references: [id])
  qrToken        String            @unique @map("qr_token")
  status         TicketStatus      @default(ISSUED)
  createdAt      DateTime          @default(now()) @map("created_at")

  checkIns CheckIn[]

  @@map("tickets")
}

model CheckIn {
  id                 String        @id @default(uuid())
  ticketId           String        @map("ticket_id")
  ticket             Ticket        @relation(fields: [ticketId], references: [id])
  eventId            String        @map("event_id")
  event              Event         @relation(fields: [eventId], references: [id])
  checkedInByUserId  String        @map("checked_in_by_user_id")
  checkedInByUser    User          @relation(fields: [checkedInByUserId], references: [id])
  checkedInAt        DateTime      @default(now()) @map("checked_in_at")
  method             CheckInMethod

  @@index([eventId])
  @@map("check_ins")
}

// ----------------------------------------------------------------
// Notifications, Audit log
// ----------------------------------------------------------------

model Notification {
  id                String              @id @default(uuid())
  recipientUserId   String              @map("recipient_user_id")
  recipient         User                @relation(fields: [recipientUserId], references: [id])
  type              String
  entityType        String              @map("entity_type")
  entityId          String              @map("entity_id")
  channel           NotificationChannel
  status            NotificationStatus  @default(PENDING)
  dedupeKey         String              @unique @map("dedupe_key")
  attempts          Int                 @default(0)
  providerMessageId String?             @map("provider_message_id")
  error             String?
  createdAt         DateTime            @default(now()) @map("created_at")
  sentAt            DateTime?           @map("sent_at")

  @@map("notifications")
}

model AuditLog {
  id           String       @id @default(uuid())
  actorUserId  String?      @map("actor_user_id")
  actor        User?        @relation(fields: [actorUserId], references: [id])
  action       String
  entityType   String       @map("entity_type")
  entityId     String       @map("entity_id")
  beforeState  Json?        @map("before_state")
  afterState   Json?        @map("after_state")
  source       AuditSource
  ipAddress    String?      @map("ip_address")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
