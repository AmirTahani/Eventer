NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://eventer:eventer@localhost:5432/events?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-jwt-secret-change-me-please
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
CORS_ORIGIN=http://localhost:3001

# Telegram — leave TELEGRAM_BOT_TOKEN empty to idle the bot process
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=EventBot
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_ID=
BOT_SERVICE_TOKEN=dev-bot-service-token

# Payments: mock (local) or orcarail
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
TICKET_QR_SECRET=dev-ticket-qr-secret-change

# OrcaRail (required when PAYMENT_PROVIDER=orcarail)
# For self-hosted OrcaRail, point ORCARAIL_BASE_URL at your instance (include /api/v1).
ORCARAIL_API_KEY=
ORCARAIL_API_SECRET=
ORCARAIL_BASE_URL=https://api.orcarail.com/api/v1
ORCARAIL_WEBHOOK_SECRET=
ORCARAIL_TOKEN_ID=
ORCARAIL_NETWORK_ID=
ORCARAIL_RETURN_URL=http://localhost:3001/payments/return
ORCARAIL_CANCEL_URL=http://localhost:3001/payments/cancel

# Optional Cloudflare R2 (file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=events-media
R2_PUBLIC_BASE_URL=

# Optional error tracking (stub logs presence; wire @sentry/node for full SDK)
SENTRY_DSN=
