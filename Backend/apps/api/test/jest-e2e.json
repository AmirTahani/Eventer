{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@eventer/common(|/.*)$": "<rootDir>/../../../libs/common/src/$1",
    "^@eventer/db(|/.*)$": "<rootDir>/../../../libs/db/src/$1",
    "^@eventer/domain(|/.*)$": "<rootDir>/../../../libs/domain/src/$1"
  }
}
