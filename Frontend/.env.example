NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
# Public bot @username (no @). Required for Telegram Login on /login.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=EventBot
# Same value — read at Next.js SSR runtime (not only baked into the client bundle).
TELEGRAM_BOT_USERNAME=EventBot
# Inbox for /contact mailto form (optional; defaults to hello@eventer.world).
NEXT_PUBLIC_CONTACT_EMAIL=hello@eventer.world
